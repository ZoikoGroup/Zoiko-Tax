# The local stack's settings: docker-compose.yml reads them from .env, beside
# it, and from nowhere else.
#
#   cp .env.example .env      # then edit .env, never this file
#   docker compose up --build -d
#
# LOCAL DEVELOPMENT ONLY. Every value below is a development placeholder for a
# stack that never holds real data. A cell takes none of this from a file:
# ADR-0017 §2.4 requires workload identity or a vault, and the local://
# references below are refused by internal/platform/secrets outside
# development, so this file cannot become the thing that ships.
#
# .env is git-ignored; this example is the only committed form. The Postman
# collection reads the bootstrap tenant and administrator from this file
# (contracts/tools/postman.mjs), so changing them here changes the collection.

# -----------------------------------------------------------------------------
# Host ports. Change these when something else on the machine holds the
# defaults; the containers listen on the same ports whatever is chosen here.
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
CORE_PORT=8080
WEB_PORT=3000

# -----------------------------------------------------------------------------
# The cell
# -----------------------------------------------------------------------------
ZTAX_CELL=local-dev
ZTAX_REGION=local
ZTAX_LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database. The owner role runs migrations; the application connects as the
# same login and drops to ztax_app per session (ADR-0008). Changing these
# after the first start needs a fresh volume: `docker compose down -v`.
# -----------------------------------------------------------------------------
POSTGRES_DB=ztax
POSTGRES_USER=ztax_owner
POSTGRES_PASSWORD=local-dev-only

# -----------------------------------------------------------------------------
# The first tenant and its administrator, provisioned at startup and a no-op
# once they exist. Changing them after the first start provisions nothing new
# unless the volume is fresh.
# -----------------------------------------------------------------------------
ZTAX_BOOTSTRAP_TENANT=acme
ZTAX_BOOTSTRAP_TENANT_NAME=Acme Telecom
ZTAX_BOOTSTRAP_ADMIN_EMAIL=admin@acme.example
ZTAX_BOOTSTRAP_ADMIN_NAME=Acme Administrator
ZTAX_BOOTSTRAP_ADMIN_PASSWORD=local-dev-only-password
# ADMIN reads no fiscal figure, so the one local user could not see the
# dashboard. Comma-separated, any of OPERATOR, ANALYST, AUDITOR; empty for
# none. Refused outside development, and granted on every start.
ZTAX_BOOTSTRAP_ADMIN_EXTRA_ROLES=ANALYST

# -----------------------------------------------------------------------------
# The key that seals webhook signing secrets at rest: 32 bytes, base64.
# -----------------------------------------------------------------------------
ZTAX_WEBHOOK_KEY=bG9jYWwtZGV2LW9ubHktd2ViaG9vay1rZXktMzJieXQ=
