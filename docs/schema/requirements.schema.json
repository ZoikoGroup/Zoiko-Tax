{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zoikotax.com/governance/requirements/v1",
  "title": "ZoikoTax requirement registry",
  "description": "ZTAX-GOV-001 §9.2: the eleven mandatory requirement fields. Cross-references (document registered, verification path exists, status consistent with document) are enforced by docs/tools/check_registry.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "document_id", "version", "statement", "rationale", "source_authority",
        "owner", "applies_to", "verification_method", "verification_ref", "status",
        "effective_from", "effective_to"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ZTAX-[A-Z][A-Z0-9]*-REQ-[0-9]{4}$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^ZTAX-[A-Z][A-Z0-9]*-[0-9]{3}$"
        },
        "version": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
        "statement": { "$ref": "#/$defs/nonEmpty" },
        "rationale": { "$ref": "#/$defs/nonEmpty" },
        "source_authority": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "verification_method": {
          "enum": ["TEST", "INSPECTION", "ANALYSIS", "AUDIT", "DEMONSTRATION"]
        },
        "verification_ref": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
        "status": { "enum": ["PROPOSED", "BASELINED", "EFFECTIVE", "RETIRED"] },
        "effective_from": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "effective_to": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }
      }
    }
  }
}
