{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zoikotax.com/governance/register/v1",
  "title": "ZoikoTax documentation estate register",
  "description": "ZTAX-GOV-001 §19 minimum register fields, plus the Build Plan §2 gap register. Cross-document rules (hashes, references, review dates) are enforced by docs/tools/check_registry.py, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["documents", "gaps"],
  "properties": {
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    }
  },
  "$defs": {
    "documentId": {
      "type": "string",
      "pattern": "^ZTAX-[A-Z][A-Z0-9]*-[0-9]{3}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id", "title", "class", "tranche", "version", "status", "owner",
        "approvers", "effective_date", "supersedes", "dependencies", "source_path",
        "publication_hash", "review_due", "applicable_release", "retention_policy"
      ],
      "properties": {
        "document_id": { "$ref": "#/$defs/documentId" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "class": {
          "description": "GOV-001 §5: CONSTITUTIONAL, SPECIFICATION, LIVING, ARTEFACT.",
          "enum": ["C", "S", "L", "A"]
        },
        "tranche": { "enum": ["EXISTING", "F0", "F0-F1", "F1", "F2"] },
        "version": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?(-[0-9A-Za-z.]+)?$" },
            { "type": "null" }
          ]
        },
        "status": {
          "description": "GOV-001 §4.4 lifecycle.",
          "enum": ["PROPOSED", "DRAFT", "BASELINED-FOR-BUILD", "APPROVED", "EFFECTIVE", "SUPERSEDED", "WITHDRAWN"]
        },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "approvers": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmpty" },
          "uniqueItems": true
        },
        "effective_date": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "supersedes": { "oneOf": [{ "$ref": "#/$defs/documentId" }, { "type": "null" }] },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/documentId" },
          "uniqueItems": true
        },
        "source_path": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
        "publication_hash": {
          "oneOf": [
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "review_due": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "applicable_release": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] },
        "retention_policy": {
          "description": "GOV-001 §5 retention by class.",
          "enum": ["PERMANENT", "10Y_AFTER_SUPERSESSION", "GIT_HISTORY", "PER_EVIDENCE_POLICY"]
        },
        "notes": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "kind", "issue", "owner", "due"],
      "properties": {
        "document_id": { "$ref": "#/$defs/documentId" },
        "kind": { "enum": ["VERIFY", "CRITICAL_PATH"] },
        "issue": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "due": { "$ref": "#/$defs/date" }
      }
    }
  }
}
