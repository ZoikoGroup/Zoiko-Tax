# Local development environment for ztax-core.
#
# Copy to .env.local. Never commit .env.local, and never put a secret in it —
# ZTAX_DATABASE_URL_REF names where a credential lives, not what it is
# (ADR-0017 §2.4).
#
# An unrecognised ZTAX_ variable refuses to start the process, so a typo here is
# reported as a typo rather than silently taking a default.

ZTAX_CELL=local-dev
ZTAX_REGION=local
ZTAX_ENVIRONMENT=development

# Release-train versions. CI stamps these; locally they are placeholders.
# In a real deployment they reach telemetry as resource attributes and the
# release evidence manifest (ADR-0015 §2.6).
ZTAX_TRAIN_APP=0.0.0-dev
ZTAX_TRAIN_CONTENT=0.0.0-dev
ZTAX_TRAIN_AI=0.0.0-dev
ZTAX_TRAIN_ADAPTER=0.0.0-dev
ZTAX_TRAIN_INFRA=0.0.0-dev
ZTAX_TRAIN_SCHEMA=0.0.0-dev
ZTAX_TRAIN_MIGRATION=0.0.0-dev

ZTAX_DATABASE_URL_REF=local://postgres

ZTAX_HTTP_ADDR=:8080
ZTAX_HTTP_READ_TIMEOUT=10s
ZTAX_HTTP_WRITE_TIMEOUT=30s
ZTAX_HTTP_SHUTDOWN_TIMEOUT=30s

ZTAX_OTLP_ENDPOINT=localhost:4317
ZTAX_LOG_LEVEL=debug

# Content. Both or neither: a bundle directory with no keyring would be content
# nobody could verify, and the process refuses to start with one of the two.
#
# Commented out because a cell with no content is a legitimate deployment before
# A4 — it serves the administrative surface and refuses determination with
# NO_CONTENT_BUNDLE. Uncomment after `make content`, which compiles and seals the
# worked pack into ../content/build and writes the keyring into ../content/.keys.
#
# They are deliberately absent from docker-compose.yml for the same reason: a
# compose stack that refused to start until somebody had run `make content`
# would break the one-command setup in the README.
#
#ZTAX_CONTENT_DIR=../content/build
#ZTAX_CONTENT_KEYRING=../content/.keys/keyring.json
