# Repository-wide. Each service keeps its own ignore file for the things only
# it produces; this covers what any of them can leave behind.

# Dependencies and build output
node_modules/
dist/
dist-tsc/
bin/
*.tsbuildinfo

# Local environment. ADR-0017 §2.4: a secret never lives in the tree, and the
# .example files are the only form of these that is committed.
.env
.env.local
.env.*.local

# Test and coverage output
coverage.out
coverage/
*.out

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Content build output and development signing keys.
#
# The compiled bundle is a CONTENT train artifact produced from the source in
# content/packs, and it is reproducible from that source — committing it would
# put two copies of the same law in the tree. The keys are development keys and
# a private key is never committed at all (ADR-0017 §2.4, §2.6).
content/build/
content/.keys/
