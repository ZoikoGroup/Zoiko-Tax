# Static files, and one proxy path to the cell.
#
# A template rather than a finished config: the nginx entrypoint runs envsubst
# over /etc/nginx/templates at startup, substituting only names that exist in
# the environment — so ${ZTAX_API_ORIGIN} is replaced and $uri, $host and the
# rest are left alone. That keeps the cell address configuration rather than
# something baked into the image, which ADR-0017 §2.2 asks of every address.
#
# The browser talks to a single origin, so there is no CORS surface and no
# preflight to configure. ADR-0019 C7 draws the line this file sits on: passing
# a request through is not server-side rendering, and nothing here holds a
# session or calls the API on a user's behalf. The day it does, it is a backend
# service and inherits a backend's controls.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS, re-resolved rather than cached at startup, so this
    # container survives ztax-core restarting on a new address instead of
    # holding a stale one until it is itself restarted.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $cell "${ZTAX_API_ORIGIN}";

    # Liveness for this container only. It answers from nginx, so it reports on
    # the web tier and says nothing about the cell — a probe that goes green
    # because something downstream is healthy is a probe that lies.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        # With a variable in proxy_pass, nginx does not strip the location
        # prefix, so it is stripped explicitly and visibly here.
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $cell;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A cell that is slow is a cell that is degraded, and the UI renders
        # degraded as itself (C3). It cannot do that while a request hangs.
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }

    # Single-page application: an unknown path is a route, not a missing file.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Vite content-hashes the bundle, so it can be cached hard. index.html is
    # not hashed and must not be cached: it names the current bundle, and a
    # stale copy pins a browser to a build that has been superseded.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
