{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-tsc/node",
    "tsBuildInfoFile": "./dist-tsc/node.tsbuildinfo",
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"]
}
