{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceCriticality",
  "description": "The criticality class of a deployable and of each user journey it serves, with the dependencies each journey has and how it behaves when one fails (ZTAX-NFR-001 §3, §11). The class decides which SLO, CapacityProfile and ResilienceProfile rules apply.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "service_criticality_id", "version", "owner", "service", "class", "journeys", "dependencies"],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "ServiceCriticality" },
    "service_criticality_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "owner": { "$ref": "common.schema.json#/$defs/owner" },
    "service": { "$ref": "common.schema.json#/$defs/service" },
    "class": {
      "description": "The highest class of any journey the service serves; the deployable is operated to it.",
      "$ref": "common.schema.json#/$defs/serviceClass"
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["journey_id", "class", "description", "operations"],
        "properties": {
          "journey_id": { "$ref": "common.schema.json#/$defs/identifier" },
          "class": { "$ref": "common.schema.json#/$defs/serviceClass" },
          "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "operations": {
            "description": "The API operations in the journey, as METHOD /path from contracts/openapi.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE) /[^ ]*$" },
            "uniqueItems": true
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "synchronous_on", "on_failure"],
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/identifier" },
          "kind": { "$ref": "common.schema.json#/$defs/dependencyKind" },
          "synchronous_on": {
            "description": "journey_ids that call this dependency synchronously. The C0 hot path makes no synchronous call to AI, authority websites, remote content databases or uncached geocoding (Build Plan W2 lane H); nfr.py refuses one.",
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/identifier" },
            "uniqueItems": true
          },
          "on_failure": { "$ref": "common.schema.json#/$defs/failureBehavior" }
        }
      }
    }
  }
}
