{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIReleaseManifest",
  "description": "The immutable, hashed deployment bundle: exactly one approved combination of use case, pinned model, prompt, evaluation and policy, bound to its allowed regions (ZTAX-AIGOV-001 §7; Master Specification Chapter 17 §14.1). Its version is recorded in every evidence record an AI-assisted step influenced (ADR-0006 §2.7).",
  "$comment": "Fields are exactly ztax_gateway.production_registries.AIReleaseManifest.as_dict(). manifest_hash is SHA-256 over the canonical JSON of every other field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "release_version",
    "ai_use_case_id",
    "authority_level",
    "risk_tier",
    "model_profile_id",
    "resolved_model_id",
    "prompt_profile_id",
    "evaluation_profile_id",
    "policy_bundle_id",
    "allowed_regions",
    "approved_at",
    "agent_profile_id",
    "tool_policy_id",
    "retrieval_corpus_version",
    "embedding_model_version",
    "fallback_profile_id",
    "manifest_hash"
  ],
  "properties": {
    "manifest_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "release_version": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "ai_use_case_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "authority_level": {
      "description": "The authority ceiling of this release. Never A5.",
      "allOf": [{ "$ref": "authority-outcome.schema.json" }, { "not": { "const": "A5" } }]
    },
    "risk_tier": { "$ref": "risk-tier.schema.json" },
    "model_profile_id": { "type": "string" },
    "resolved_model_id": { "type": "string" },
    "prompt_profile_id": { "type": "string" },
    "evaluation_profile_id": { "type": "string" },
    "policy_bundle_id": { "type": "string" },
    "allowed_regions": {
      "description": "Non-empty: a manifest with no approved region cannot execute anywhere.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/region" },
      "minItems": 1,
      "uniqueItems": true
    },
    "approved_at": { "type": "string", "format": "date-time" },
    "agent_profile_id": { "$ref": "common.schema.json#/$defs/identifierOrNull" },
    "tool_policy_id": { "$ref": "common.schema.json#/$defs/identifierOrNull" },
    "retrieval_corpus_version": { "type": ["string", "null"] },
    "embedding_model_version": { "type": ["string", "null"] },
    "fallback_profile_id": { "$ref": "common.schema.json#/$defs/identifierOrNull" },
    "manifest_hash": { "$ref": "common.schema.json#/$defs/sha256" }
  }
}
