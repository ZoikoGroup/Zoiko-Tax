{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChargeComponent",
  "description": "How a component is charged, independent of what it is (ZTAX-CLS-REQ-0041 to -0043).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "component_id",
    "charge_type"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "ChargeComponent"
    },
    "component_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "charge_type": {
      "$ref": "common.schema.json#/$defs/chargeType"
    }
  }
}
