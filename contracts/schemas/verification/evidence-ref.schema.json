{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceRef",
  "description": "A pointer to one piece of verification evidence: what it is, where it is, and the digest that makes it checkable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "uri",
    "digest"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "TEST_REPORT",
        "GOLDEN_RUN",
        "REPLAY_REPORT",
        "INSPECTION",
        "AUDIT",
        "SBOM",
        "PROVENANCE",
        "SIGNATURE"
      ]
    },
    "uri": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/date"
    }
  }
}
