{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObligationStatusChanged",
  "description": "An obligation row was written: created OPEN on its period's first assessment, or moved — by a user, or by a commit that changed figures somebody had acted on (ZTAX-OBL-REQ-0084). Emitted in the transaction that wrote the row. Dates are civil dates in the obligation's legal calendar. Carries no assessed amount; read it from GET /v1/obligations/{obligationId}.",
  "$comment": "Producer: backend/internal/app/events.go (appendObligation). Event type com.zoikotax.obligation.status-changed; schema ref ztax:events/obligation-status-changed/1.0.0. Partition key obligation/<businessKey>.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "obligationId",
    "type",
    "authority",
    "jurisdiction",
    "legalEntityId",
    "periodStart",
    "periodEnd",
    "dueDate",
    "status",
    "recordedAt"
  ],
  "properties": {
    "obligationId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "legalEntityId": {
      "type": "string",
      "format": "uuid"
    },
    "periodStart": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "periodEnd": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dueDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "enum": [
        "OPEN",
        "DATA_REQUIRED",
        "READY",
        "FILED",
        "ACCEPTED",
        "REJECTED",
        "UNCERTAIN",
        "PAYMENT_DUE",
        "PAID",
        "AMENDMENT_REQUIRED",
        "SUSPENDED",
        "CLOSED"
      ]
    },
    "previousStatus": {
      "enum": [
        "OPEN",
        "DATA_REQUIRED",
        "READY",
        "FILED",
        "ACCEPTED",
        "REJECTED",
        "UNCERTAIN",
        "PAYMENT_DUE",
        "PAID",
        "AMENDMENT_REQUIRED",
        "SUSPENDED",
        "CLOSED"
      ]
    },
    "supersedes": {
      "type": "string",
      "format": "uuid"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "dependentRequired": {
    "supersedes": [
      "previousStatus"
    ],
    "previousStatus": [
      "supersedes"
    ]
  }
}
